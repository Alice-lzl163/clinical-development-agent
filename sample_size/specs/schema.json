{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-development-agent.local/sample-size-method.schema.json",
  "title": "Sample Size Statistical Method Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_key", "method_id", "display_name", "endpoint_family", "design_family",
    "estimand", "hypothesis", "inputs", "alpha", "allocation", "solve_modes",
    "engine", "method_type", "dropout_handling", "rounding_rule", "assumptions",
    "unsupported_domains", "warnings", "validation_grade", "migration_action",
    "lifecycle_status", "primary_reference", "package_reference",
    "guideline_reference", "benchmark_requirements"
  ],
  "properties": {
    "test_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "method_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "endpoint_family": {"type": "string", "minLength": 1},
    "design_family": {"type": "string", "minLength": 1},
    "estimand": {"type": "string", "minLength": 1},
    "hypothesis": {"$ref": "#/$defs/hypothesis"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "alpha": {"$ref": "#/$defs/alpha"},
    "allocation": {"$ref": "#/$defs/allocation"},
    "solve_modes": {"$ref": "#/$defs/solveModes"},
    "engine": {"$ref": "#/$defs/engine"},
    "method_type": {"enum": ["exact_package", "asymptotic", "analytical", "simulation"]},
    "dropout_handling": {"type": "string", "minLength": 1},
    "rounding_rule": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unsupported_domains": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_grade": {"enum": ["V1", "V2", "V3", "V4", "V5"]},
    "migration_action": {"enum": ["KEEP", "KEEP_AND_VALIDATE", "REPLACE", "REDESIGN", "DEPRECATE"]},
    "lifecycle_status": {"enum": ["EXPERIMENTAL", "VALIDATION_PENDING"]},
    "primary_reference": {"type": "string", "minLength": 1},
    "package_reference": {"type": ["string", "null"]},
    "guideline_reference": {"type": "string", "minLength": 1},
    "benchmark_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["null", "alternative", "effect_measure", "beneficial_direction"],
      "properties": {
        "null": {"type": "string", "minLength": 1},
        "alternative": {"type": "string", "minLength": 1},
        "effect_measure": {"type": "string", "minLength": 1},
        "beneficial_direction": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "definition", "type", "unit", "required", "valid_range", "default", "clinical_interpretation"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "definition": {"type": "string", "minLength": 1},
        "type": {"enum": ["number", "integer", "string", "boolean", "array", "object"]},
        "unit": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "valid_range": {"type": ["object", "null"]},
        "default": {},
        "clinical_interpretation": {"type": "string", "minLength": 1}
      }
    },
    "alpha": {
      "type": "object", "additionalProperties": false,
      "required": ["sidedness", "convention"],
      "properties": {
        "sidedness": {"enum": ["one_sided", "two_sided", "one_or_two_sided", "two_one_sided_tests"]},
        "convention": {"type": "string", "minLength": 1}
      }
    },
    "allocation": {
      "type": "object", "additionalProperties": false,
      "required": ["ratio_definition", "supported", "rounding_rule"],
      "properties": {
        "ratio_definition": {"type": "string", "minLength": 1},
        "supported": {"type": "boolean"},
        "rounding_rule": {"type": "string", "minLength": 1}
      }
    },
    "solveModes": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_size", "power", "events", "operating_characteristics"],
      "properties": {
        "sample_size": {"type": "boolean"}, "power": {"type": "boolean"},
        "events": {"type": "boolean"}, "operating_characteristics": {"type": "boolean"}
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["engine_family", "type", "package", "package_version_policy", "function", "function_signature", "parameter_mapping", "output_mapping"],
      "properties": {
        "engine_family": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["exact_package", "asymptotic", "analytical", "simulation"]},
        "package": {"type": ["string", "null"]},
        "package_version_policy": {"type": "string", "minLength": 1},
        "function": {"type": ["string", "null"]},
        "function_signature": {"type": ["string", "null"]},
        "parameter_mapping": {"type": "object"},
        "output_mapping": {"type": "object"}
      }
    }
  }
}
