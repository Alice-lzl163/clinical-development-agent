{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-development-agent.local/sample-size-method.schema.json",
  "title": "Sample Size Statistical Method Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["test_key", "method_id", "display_name", "endpoint_family", "design_family", "estimand", "hypothesis", "inputs", "design_components", "derived_parameters", "alpha", "allocation", "solve_modes", "engine", "method_type", "dropout_handling", "rounding_rule", "assumptions", "unsupported_domains", "warnings", "validation_grade", "migration_action", "specification_status", "lifecycle_status", "primary_reference", "package_reference", "guideline_reference", "benchmark_requirements"],
  "properties": {
    "test_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "method_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "endpoint_family": {"type": "string", "minLength": 1},
    "design_family": {"type": "string", "minLength": 1},
    "estimand": {"type": "string", "minLength": 1},
    "hypothesis": {"$ref": "#/$defs/hypothesis"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "design_components": {"type": "array", "items": {"$ref": "#/$defs/designComponent"}},
    "derived_parameters": {"type": "array", "items": {"$ref": "#/$defs/derivedParameter"}},
    "alpha": {"$ref": "#/$defs/alpha"},
    "allocation": {"$ref": "#/$defs/allocation"},
    "solve_modes": {"$ref": "#/$defs/solveModes"},
    "engine": {"$ref": "#/$defs/engine"},
    "method_type": {"enum": ["analytical_exact", "analytical_asymptotic", "numerical", "simulation", "precision", "operating_characteristics"]},
    "dropout_handling": {"type": "string", "minLength": 1},
    "rounding_rule": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "unsupported_domains": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_grade": {"enum": ["V1", "V2", "V3", "V4", "V5"]},
    "migration_action": {"enum": ["KEEP", "KEEP_AND_VALIDATE", "REPLACE", "REDESIGN", "DEPRECATE"]},
    "specification_status": {"enum": ["DRAFT", "SPEC_FROZEN"]},
    "lifecycle_status": {"enum": ["EXPERIMENTAL", "VALIDATION_PENDING"]},
    "primary_reference": {"type": "string", "minLength": 1},
    "package_reference": {"type": ["string", "null"]},
    "guideline_reference": {"type": "string", "minLength": 1},
    "benchmark_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["null", "alternative", "effect_measure", "beneficial_direction"],
      "properties": {
        "null": {"type": "string", "minLength": 1}, "alternative": {"type": "string", "minLength": 1},
        "effect_measure": {"type": "string", "minLength": 1}, "beneficial_direction": {"type": "string", "minLength": 1}
      }
    },
    "validRange": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "minimum": {"type": "number"}, "maximum": {"type": "number"},
        "exclusive_minimum": {"type": "number"}, "exclusive_maximum": {"type": "number"},
        "allowed_values": {"type": "array", "minItems": 1, "uniqueItems": true}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "definition", "type", "unit", "required", "valid_range", "default", "clinical_interpretation"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "definition": {"type": "string", "minLength": 1},
        "type": {"enum": ["number", "integer", "string", "boolean", "array", "object"]},
        "unit": {"type": "string", "minLength": 1}, "required": {"type": "boolean"},
        "valid_range": {"$ref": "#/$defs/validRange"}, "default": {}, "component_ref": {"type": ["string", "null"]},
        "required_for_solve_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["sample_size", "power", "events", "operating_characteristics"]}},
        "allowed_for_solve_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["sample_size", "power", "events", "operating_characteristics"]}},
        "clinical_interpretation": {"type": "string", "minLength": 1}
      }
    },
    "alpha": {
      "type": "object", "additionalProperties": false, "required": ["sidedness", "convention"],
      "properties": {"sidedness": {"enum": ["one_sided", "two_sided", "one_or_two_sided", "two_one_sided_tests", "not_applicable"]}, "convention": {"type": "string", "minLength": 1}}
    },
    "allocation": {
      "type": "object", "additionalProperties": false, "required": ["ratio_definition", "supported", "rounding_rule"],
      "properties": {"ratio_definition": {"type": "string", "minLength": 1}, "supported": {"type": "boolean"}, "rounding_rule": {"type": "string", "minLength": 1}}
    },
    "solveModes": {
      "type": "object", "additionalProperties": false, "required": ["sample_size", "power", "events", "operating_characteristics"],
      "properties": {"sample_size": {"type": "boolean"}, "power": {"type": "boolean"}, "events": {"type": "boolean"}, "operating_characteristics": {"type": "boolean"}}
    },
    "formalArgument": {
      "type": "object", "additionalProperties": false, "required": ["name", "required", "package_default", "semantic_role"],
      "properties": {"name": {"type": "string", "pattern": "^[A-Za-z.][A-Za-z0-9._]*$"}, "required": {"type": "boolean"}, "package_default": {}, "semantic_role": {"type": "string", "minLength": 1}}
    },
    "derivedParameter": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "formula", "inputs", "output_unit", "assumptions"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "formula": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"}},
        "output_unit": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "transformation_type": {"enum": ["formula", "conditional"]},
        "cases": {
          "type": "object", "minProperties": 1, "additionalProperties": false,
          "patternProperties": {"^[a-z][a-z0-9_]*$": {"type": "object", "additionalProperties": false, "required": ["multiplier"], "properties": {"multiplier": {"type": "number"}}}}
        }
      },
      "allOf": [{"if": {"properties": {"transformation_type": {"const": "conditional"}}, "required": ["transformation_type"]}, "then": {"required": ["cases"]}}]
    },
    "parameterMap": {
      "type": "object", "additionalProperties": false,
      "required": ["package_argument", "source_type", "source", "transformation"],
      "properties": {
        "package_argument": {"type": "string", "pattern": "^[A-Za-z.][A-Za-z0-9._]*$"},
        "source_type": {"enum": ["clinical_input", "design_component", "derived_parameter", "constant", "unresolved"]},
        "source": {"type": ["string", "number", "boolean", "null"]},
        "transformation": {"type": ["string", "null"]}
      }
    },
    "outputMap": {
      "type": "object", "additionalProperties": false,
      "required": ["package_output", "semantic_output", "unit"],
      "properties": {
        "package_output": {"type": "string", "minLength": 1},
        "semantic_output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "designComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "component_type", "required", "fields", "adapter"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "component_type": {"enum": ["SequentialDesignSpec", "SurvivalEndpointSpec", "AccrualSpec", "DropoutSpec"]},
        "required": {"type": "boolean"},
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
        "adapter": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/componentAdapter"}]}
      }
    },
    "componentAdapter": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "package", "function", "formal_arguments", "parameter_mapping", "output"],
      "properties": {
        "runtime": {"const": "R"}, "package": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "formal_arguments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/formalArgument"}},
        "parameter_mapping": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/parameterMap"}},
        "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "engine_family", "package", "package_version_policy", "function", "formal_arguments", "parameter_mapping", "output_mapping"],
      "properties": {
        "runtime": {"enum": ["R", "PYTHON", "NONE"]},
        "engine_family": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "package": {"type": ["string", "null"]}, "package_version_policy": {"type": "string", "minLength": 1},
        "function": {"type": ["string", "null"]},
        "formal_arguments": {"type": "array", "items": {"$ref": "#/$defs/formalArgument"}},
        "parameter_mapping": {"type": "array", "items": {"$ref": "#/$defs/parameterMap"}},
        "output_mapping": {"type": "array", "items": {"$ref": "#/$defs/outputMap"}}
      },
      "allOf": [
        {"if": {"properties": {"function": {"type": "string"}}, "required": ["function"]}, "then": {"properties": {"package": {"type": "string", "minLength": 1}, "runtime": {"const": "R"}, "formal_arguments": {"minItems": 1}}}},
        {"if": {"properties": {"runtime": {"const": "NONE"}}, "required": ["runtime"]}, "then": {"properties": {"package": {"type": "null"}, "function": {"type": "null"}, "formal_arguments": {"maxItems": 0}}}}
      ]
    }
  }
}
